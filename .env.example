# ── Telegram ────────────────────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram user/group chat ID (use @userinfobot to find yours).
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Vinted session (Feature 1 & 2) ──────────────────────────────────────────
# Log in to Vinted in your browser, open DevTools → Application → Cookies,
# and copy the value of the `_vinted_fr_session` cookie (or _vinted_com_session
# depending on your region).
VINTED_SESSION_COOKIE=your_vinted_session_cookie_here

# ── Feature 1 – Search Monitor ───────────────────────────────────────────────
# Full Vinted search URL (copy from your browser after applying filters).
SEARCH_URL=https://www.vinted.fr/catalog?search_text=nike+air+force

# How often to poll (seconds). Default: 60.
POLL_INTERVAL=60

# Filters applied AFTER the API returns results (leave blank to skip a filter).
MAX_PRICE=80
# Comma-separated, case-insensitive substring match against brand name.
BRANDS=Nike,Adidas
# Comma-separated, case-insensitive substring match against size label.
SIZES=M,L,42,43
# Comma-separated; valid Vinted statuses: new_with_tags, new_without_tags,
# very_good, good, satisfactory
CONDITIONS=new_with_tags,new_without_tags,very_good
# Seller feedback score 0.0–1.0 (e.g. 0.8 = 80 % positive).
MIN_SELLER_RATING=0.8

# ── Feature 2 – AI Auto-Listing Bot ─────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vinted login credentials used by Playwright to post listings.
VINTED_EMAIL=your_vinted_email@example.com
VINTED_PASSWORD=your_vinted_password_here

# Vinted base URL for Playwright (change to .com / .de / .be etc. as needed).
VINTED_BASE_URL=https://www.vinted.fr
